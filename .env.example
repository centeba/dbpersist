API_KEY=dev-api-key
PERSIST_DATABASE_URL=postgresql+asyncpg://dbpersist:dbpersist@localhost:5442/persist
PUBSUB_DATABASE_URL=postgresql+asyncpg://dbpersist:dbpersist@localhost:5442/pubsub
PUBSUB_SYNC_DATABASE_URL=postgresql+psycopg://dbpersist:dbpersist@localhost:5442/pubsub
REDIS_URL=redis://localhost:6389/0
PERSIST_URL=http://localhost:8101
PUBSUB_URL=http://localhost:8102
IDLE_SUBSCRIBER_MINUTES=60

# Observability (empty endpoint = export off; structured logs still go to stdout)
OTEL_EXPORTER_OTLP_ENDPOINT=
DEPLOYMENT_ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json
